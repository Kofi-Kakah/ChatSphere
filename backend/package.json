{
  "name": "chatsphere-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "test": "vitest run --config ./vitest.config.js --configLoader runner",
    "test:api": "vitest run --config ./vitest.config.js --configLoader runner tests/api tests/health.test.js",
    "test:socket": "vitest run --config ./vitest.config.js --configLoader runner tests/socket",
    "test:db": "vitest run --config ./vitest.config.js --configLoader runner tests/db",
    "test:security": "vitest run --config ./vitest.config.js --configLoader runner tests/security",
    "test:load": "vitest run --config ./vitest.config.js --configLoader runner tests/load",
    "test:soak": "vitest run --config ./vitest.config.js --configLoader runner tests/soak"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "ws": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "mongodb-memory-server": "^10.2.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "vitest": "^5.0.5"
  }
}
